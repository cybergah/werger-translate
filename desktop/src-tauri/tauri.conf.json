{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wergêr",
  "version": "1.0.0",
  "identifier": "com.cybergah.werger",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wergêr",
        "width": 1040,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Cybergah Group",
    "copyright": "© Cybergah Group · cybergah.com",
    "category": "Education",
    "shortDescription": "Wergêr — offline/online translator",
    "longDescription": "Wergêr is a free, open-source online/offline translation app by Cybergah Group, specialized in Kurdish (Kurmancî and Soranî) alongside Turkish, English, Arabic and Farsi."
  },
  "plugins": {}
}
