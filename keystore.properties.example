# Copy this file to `keystore.properties` (which is git-ignored) and fill in
# your own release-signing values. Without it the app still builds UNSIGNED.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore keystore/wergir-release.jks \
#           -keyalg RSA -keysize 4096 -validity 10000 -alias wergir
#
# For CI, provide these as encrypted secrets instead of committing the file.

storeFile=keystore/wergir-release.jks
storePassword=CHANGE_ME
keyAlias=wergir
keyPassword=CHANGE_ME
