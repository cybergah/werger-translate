# Wergêr — Git attributes

# Normalize line endings for text files.
* text=auto eol=lf

# Windows / shell scripts keep their native endings.
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf
gradlew      text eol=lf
*.sh         text eol=lf

# --- Large model / binary assets ---
# The NLLB-200 ONNX model (~870 MB) is NOT committed to this repo; it is
# downloaded at runtime (see README / NOTICE). If you ever DO need to version
# large binaries, track them with Git LFS instead of committing them directly:
#
#   git lfs install
#   git lfs track "*.onnx"
#
# The lines below declare LFS tracking AND mark these as binary so Git never
# tries to diff/merge them as text. Remove the "filter=lfs ..." part if you are
# not using LFS.
*.onnx       filter=lfs diff=lfs merge=lfs -text
*.ort        filter=lfs diff=lfs merge=lfs -text
*.bin        filter=lfs diff=lfs merge=lfs -text

# Other binary assets — mark binary (no LFS) so diffs stay clean.
*.png        binary
*.jpg        binary
*.jpeg       binary
*.webp       binary
*.ico        binary
*.icns       binary
*.ttf        binary
*.otf        binary
*.woff       binary
*.woff2      binary
*.apk        binary
*.aab        binary
*.msi        binary
*.exe        binary
*.pdf        binary
*.keystore   binary
*.jks        binary

# GitHub language stats: don't count vendored/build dirs.
node_modules/**     linguist-vendored
**/build/**         linguist-generated
**/target/**        linguist-generated
